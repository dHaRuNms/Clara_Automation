# Clara AI – Environment Variables
# Copy this file to .env and fill in your API keys.
# All services used are FREE TIER.

# ── Gemini (Classic Mode fallback) ──
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Retell AI ──
# Get yours at: https://www.retellai.com/
RETELL_API_KEY=key_8b72c05fa199b67482f7bcc7e083

# ── AssemblyAI (audio transcription) ──
# Get yours at: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=bf81c834ee6a41878f223c6c6d2d3cd1

# ── NVIDIA NIM (Multi-Agent Mode) ──
# Get your FREE API key at: https://build.nvidia.com → top-right → "Get API Key"
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model selection (change to any model from build.nvidia.com)
NVIDIA_EXTRACTOR_MODEL=mistralai/mixtral-8x22b-instruct-v0.1
NVIDIA_RESEARCH_MODEL=meta/llama-3.1-405b-instruct
NVIDIA_DEFAULT_MODEL=meta/llama-3.3-70b-instruct
