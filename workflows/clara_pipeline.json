    {
      "parameters": {
        "jsCode": "// Extract the pipeline result\nconst input = $input.first();\nconst result = input.json.output || input.json;\n\nconst hasAppointment = result.appointment_details && result.appointment_details.start_time;\n\nreturn [{\n  json: {\n    account_id: result.account_id || 'unknown',\n    pipeline: result.pipeline || 'demo',\n    version: result.version || 'v1',\n    status: result.status || 'unknown',\n    company_name: result.memo_summary?.company || result.account_id || '',\n    unknowns_count: result.memo_summary?.unknowns_count || 0,\n    has_appointment: hasAppointment || false,\n    appointment: hasAppointment ? result.appointment_details : null\n  }\n}];"
      },
      "id": "node-parse-demo-result",
      "name": "\ud83d\udcca Parse Demo Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1750,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract the pipeline result\nconst input = $input.first();\nconst result = input.json.output || input.json;\n\nconst hasAppointment = result.appointment_details && result.appointment_details.start_time;\n\nreturn [{\n  json: {\n    account_id: result.account_id || 'unknown',\n    pipeline: result.pipeline || 'onboarding',\n    version: result.version || 'v2',\n    status: result.status || 'unknown',\n    company_name: result.memo_summary?.company || result.account_id || '',\n    changes_count: result.changes_count || 0,\n    has_appointment: hasAppointment || false,\n    appointment: hasAppointment ? result.appointment_details : null\n  }\n}];"
      },
