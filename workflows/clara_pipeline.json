    {
      "parameters": {
        "jsCode": "// Log the result for this file\nconst input = $input.first();\nconst result = input.json;\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    account_id: result.account_id || 'unknown',\n    pipeline: result.pipeline || 'unknown',\n    version: result.version || 'unknown',\n    status: result.status || 'unknown',\n    company_name: result.company_name || '',\n    calendar_event_created: result.has_appointment || false,\n    changes_count: result.changes_count || 0\n  }\n}];"
      },
      "id": "node-log-result",
      "name": "\ud83d\udccb Log Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2600,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build final summary when all batches are done\nconst items = $input.all();\nconst results = items.map(i => i.json);\n\nconst total = results.length;\nconst success = results.filter(r => r.status === 'success').length;\nconst failed = results.filter(r => r.status === 'error').length;\nconst demos = results.filter(r => r.pipeline === 'demo').length;\nconst onboardings = results.filter(r => r.pipeline === 'onboarding').length;\nconst calendarEvents = results.filter(r => r.calendar_event_created).length;\n\nreturn [{\n  json: {\n    pipeline_run: new Date().toISOString(),\n    total_files_processed: total,\n    successful: success,\n    failed: failed,\n    demo_pipelines: demos,\n    onboarding_pipelines: onboardings,\n    calendar_events_created: calendarEvents,\n    accounts: results.map(r => ({\n      account: r.account_id,\n      type: r.pipeline,\n      status: r.status\n    }))\n  }\n}];"
      },
      "id": "node-summary",
      "name": "\ud83d\udcca Batch Summary Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2850,
        400
      ]
    }
