      "id": "node-list-files",
      "name": "\ud83d\udcc1 List Transcript Files",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse the file listing and sort: demos first, then onboarding\nconst input = $input.first();\nconst files = input.json.files || [];\n\nfiles.sort((a, b) => {\n  if (a.type === 'demo' && b.type === 'onboarding') return -1;\n  if (a.type === 'onboarding' && b.type === 'demo') return 1;\n  return a.account.localeCompare(b.account);\n});\n\nreturn files.map(f => ({ json: f }));"
      },
      "id": "node-parse-files",
      "name": "\ud83d\udd00 Parse & Sort Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-demo",
              "leftValue": "={{ $json.type }}",
              "rightValue": "demo",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-route-type",
      "name": "\ud83d\udccb Demo or Onboarding?",
